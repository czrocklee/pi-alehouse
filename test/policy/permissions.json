{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "piInfrastructureReadPaths": [],
  "authorizerChain": ["directory-search-scope", "auto-model-judge", "jev-model-judge"],
  "permission": {
    "*": "ask",
    "managed_static_read": "allow",
    "managed_static_file_effects": "allow",
    "path": {
      "*": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "*.p12": "ask",
      "*.pfx": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/sops/*": "deny",
      "~/.config/sops/age/*": "deny",
      "~/.config/sops-nix/secrets": "deny",
      "~/.config/sops-nix/secrets/*": "deny",
      "/run/secrets": "deny",
      "/run/secrets/*": "deny",
      "/run/secrets.d": "deny",
      "/run/secrets.d/*": "deny",
      "/run/user/*/secrets": "deny",
      "/run/user/*/secrets/*": "deny",
      "/run/user/*/secrets.d": "deny",
      "/run/user/*/secrets.d/*": "deny",
      "~/.config/age/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/web-search.json": "deny",
      "file:*": "deny",
      "*/file:*": "deny",
      "@file:*": "deny",
      "*/@file:*": "deny"
    },
    "path_write": {
      ".git": "deny",
      "*/.git": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "~/.gitconfig": "deny",
      "~/.config/git/*": "deny",
      ".pi/extensions/*": {"action": "deny", "reason": "Project-scoped permission policy overrides global policy. Edit it outside the agent."},
      "*/.pi/extensions/*": {"action": "deny", "reason": "Project-scoped permission policy overrides global policy. Edit it outside the agent."},
      ".pi/agents/*": {"action": "deny", "reason": "Agent frontmatter overrides both permission scopes. Edit it outside the agent."},
      "*/.pi/agents/*": {"action": "deny", "reason": "Agent frontmatter overrides both permission scopes. Edit it outside the agent."},
      ".pi/agent/*": "deny",
      "*/.pi/agent/*": "deny",
      "~/.pi/*": {"action": "deny", "reason": "Pi configuration and credentials must be edited outside the agent."}
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "ask",
      "git status --short": "allow",
      "mktemp -d": "allow",
      "pwd": "allow",
      "wc *": "allow",
      "head *": "allow",
      "rg --no-config *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "cut *": "allow",
      "nl *": "allow",
      "sha256sum *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "tr *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "uname *": "allow",
      "ls *": "allow",
      "stat *": "allow",
      "cd *": "allow",
      "sudo *": {"action": "deny", "reason": "Run privileged commands manually outside the agent."},
      "doas *": {"action": "deny", "reason": "Run privileged commands manually outside the agent."},
      "su *": {"action": "deny", "reason": "Privilege escalation is not allowed for the agent."},
      "shutdown *": "deny",
      "reboot *": "deny",
      "poweroff *": "deny",
      "halt *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "rm -rf /": {"action": "deny", "reason": "Refusing to recursively remove the filesystem root."}
    },
    "web_search": "ask",
    "source_check": "ask",
    "fetch_content": "ask",
    "get_search_content": "allow",
    "spawn_agent": "allow",
    "read_run": "allow",
    "steer_run": "allow",
    "resume_agent": "allow",
    "wait_runs": "allow",
    "list_agents": "allow",
    "cancel_run": "allow",
    "release_agent": "allow",
    "notify_parent": "allow",
    "ask_parent": "allow",
    "mcp": {"*": "ask", "mcp_status": "allow", "mcp_list": "allow", "mcp_search": "allow", "mcp_describe": "allow"},
    "skill": {"*": "allow"},
    "external_directory": {"*": "ask", "/tmp": "allow", "/tmp/*": "allow"},
    "external_directory_read": {"/proc/meminfo": "allow", "/proc/self/mountinfo": "allow"}
  }
}
