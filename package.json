{
  "name": "pi-alehouse",
  "version": "0.1.0",
  "description": "An integrated local multi-agent orchestration layer for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Yang Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czrocklee/pi-alehouse.git"
  },
  "bugs": "https://github.com/czrocklee/pi-alehouse/issues",
  "homepage": "https://github.com/czrocklee/pi-alehouse#readme",
  "bin": {
    "pi-alehouse": "bin/pi-alehouse.mjs"
  },
  "pi": {
    "extensions": []
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "tsconfig.json",
    "eslint.config.mjs",
    "release-policy.json",
    "generated/",
    "resources/",
    "scripts/build/",
    "scripts/init.mjs",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build/index.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/checks/check-pi-types.mjs",
    "lint": "eslint --max-warnings 0 src/orchestration src/shared test/unit test/sdk test/packaging test/host test/tui test/support",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:policy",
    "test": "npm run build && node --test test/unit/*.test.mjs test/sdk/*.test.mjs test/packaging/*.test.mjs test/extensions/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "npm run build && node --test test/unit/*.test.mjs",
    "test:sdk": "npm run build && node --test test/sdk/*.test.mjs",
    "test:packaging": "npm run build && node --test test/packaging/*.test.mjs test/integration/*.test.mjs",
    "test:policy": "bash scripts/checks/check-pi-agents.sh",
    "test:integration": "bash scripts/collect-alehouse-evidence.sh --all",
    "test:host": "node test/host/session-integration.mjs",
    "test:host:run-lifecycle": "node test/host/run-lifecycle.mjs"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "32.0.3",
    "pi-web-access": "0.47.0",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "os": [
    "linux"
  ]
}
