{
  "name": "pi-alehouse",
  "version": "0.1.0",
  "description": "An integrated local multi-agent orchestration harness for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Yang Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czrocklee/pi-alehouse.git"
  },
  "bugs": "https://github.com/czrocklee/pi-alehouse/issues",
  "homepage": "https://github.com/czrocklee/pi-alehouse#readme",
  "bin": {
    "pi-alehouse": "bin/pi-alehouse.mjs"
  },
  "pi": {
    "extensions": []
  },
  "files": [
    "bin/",
    "composition.ts",
    "harness/src/",
    "harness/test/",
    "harness/docs/",
    "harness/tsconfig.json",
    "harness/eslint.config.mjs",
    "harness/release-policy.json",
    "extensions/",
    "lib/",
    "permission-system/",
    "runtime/",
    "resources/",
    "scripts/",
    "test/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p harness/tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p harness/tsconfig.json --noEmit && node harness/test/support/shared-library-types.mjs && node scripts/check-pi-types.mjs",
    "lint": "eslint --config harness/eslint.config.mjs --max-warnings 0 harness lib",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:policy",
    "test": "npm run build && node --test harness/test/unit/*.test.mjs harness/test/sdk/*.test.mjs harness/test/packaging/*.test.mjs test/*.test.mjs test/runtime/*.test.mjs",
    "test:unit": "npm run build && node --test harness/test/unit/*.test.mjs",
    "test:sdk": "npm run build && node --test harness/test/sdk/*.test.mjs",
    "test:packaging": "npm run build && node --test harness/test/packaging/*.test.mjs test/runtime/*.test.mjs",
    "test:policy": "bash scripts/check-pi-agents.sh",
    "test:integration": "bash scripts/collect-pi-harness-evidence.sh --all",
    "test:host": "node harness/test/host/session-integration.mjs",
    "test:host:run-lifecycle": "node harness/test/host/run-lifecycle.mjs"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "32.0.3",
    "pi-web-access": "0.31.0",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "os": ["linux"]
}
